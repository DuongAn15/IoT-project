# ========================================================
# ADHT WEATHER STATION - NESTJS BACKEND GATEWAY CONFIG
# ========================================================
# Copy file này thành .env trong thư mục adht-weather-backend:
# cp .env.example .env

# 1. Server Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=api

# 2. EMQX Cloud Serverless (MQTT Broker kết nối ESP32)
MQTT_BROKER_HOST=xxxxxxxx.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=adht_device
MQTT_PASSWORD=Your_Mqtt_Password
MQTT_USE_TLS=true
MQTT_CLIENT_ID=adht_backend_gateway

# 3. Supabase Database (PostgreSQL Time-Series)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_secret_key
SUPABASE_TABLE=weather_logs

# 4. Firebase Cloud Messaging (FCM Push Notifications)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_ALERT_TOPIC=adht_weather_alerts

# 5. OpenWeatherMap API (Dự báo 3 ngày)
OPENWEATHER_API_KEY=
DEFAULT_LAT=10.7769
DEFAULT_LON=106.7009

# 6. Ngưỡng cảnh báo thiên tai tự động
ALERT_TEMP_MAX=38.0
ALERT_TEMP_MIN=10.0
ALERT_HUMI_MAX=90.0
ALERT_WIND_MAX=15.0
ALERT_RAIN_MAX=30.0

