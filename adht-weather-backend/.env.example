# ========================================================
# ADHT WEATHER STATION - NESTJS BACKEND GATEWAY CONFIG
# ========================================================
# Copy file này thành .env trong thư mục adht-weather-backend:
# cp .env.example .env

# 1. Server Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=api
# Comma-separated allowed origins when credentials=true (e.g. https://app.example.com,http://localhost:8080)
CORS_ORIGINS=
# Shared API token required in production (Authorization: Bearer <token> or x-api-key: <token>)
API_AUTH_TOKEN=
# Optional comma-separated allowlist of permitted device IDs (empty = all registered devices)
ALLOWED_DEVICE_IDS=
# Optional P04 device-to-deployment binding (e.g. adht_weather_01=dep-001)
DEVICE_DEPLOYMENTS=
# Optional JSON map of device ID -> human-readable station location (metadata only; never used for time bucketing)
# STATION_LOCATIONS={"adht_weather_01":"Trung tâm, Đà Nẵng, Việt Nam"}
# Optional durable journal path for P04 v2 dedup across restarts
V2_DEDUP_FILE=
# Set to true after v2 minute-log cutover to stop writing v1 5s samples into DB history
V2_CUTOVER_ENABLED=false
# Optional HTTP webhook telemetry ingestion (disabled by default -> 501 Not Implemented)
ENABLE_WEBHOOK_TELEMETRY=false

# 2. EMQX Cloud Serverless (MQTT Broker kết nối ESP32)
MQTT_BROKER_HOST=xxxxxxxx.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=adht_device
MQTT_PASSWORD=Your_Mqtt_Password
MQTT_USE_TLS=true
# Mỗi instance backend phải có client ID riêng (vd. adht_backend_cloud cho bản cloud),
# nếu trùng thì broker sẽ ngắt kết nối instance cũ.
MQTT_CLIENT_ID=adht_backend_gateway

# 3. Supabase Database (PostgreSQL Time-Series)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_secret_key
SUPABASE_TABLE=weather_logs
SUPABASE_V2_TABLE=weather_logs_v2

# 4. Firebase Cloud Messaging (FCM Push Notifications)
# Local: trỏ tới file JSON service account (đặt trong adht-weather-backend/, đã gitignore)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Cloud (Railway/Render/Fly...): dán nội dung file JSON, hoặc bản base64 của nó.
# Nếu biến này có giá trị thì được ưu tiên hơn FIREBASE_CREDENTIALS_PATH.
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_ALERT_TOPIC=adht_weather_alerts

# 5. OpenWeatherMap API (Dự báo 3 ngày)
OPENWEATHER_API_KEY=
DEFAULT_LAT=10.7769
DEFAULT_LON=106.7009

# 6. Ngưỡng cảnh báo thiên tai tự động
ALERT_TEMP_MAX=38.0
ALERT_TEMP_MIN=10.0
ALERT_HUMI_MAX=90.0
ALERT_WIND_MAX=15.0
ALERT_RAIN_MAX=30.0

