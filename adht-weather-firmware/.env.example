# ==========================================
# ADHT WEATHER STATION - ENVIRONMENT VARIABLES
# ==========================================
# Copy file này thành .env và điền thông tin thật của bạn:
# cp .env.example .env

# 1. WiFi Credentials
DEFAULT_WIFI_SSID="Your_WiFi_SSID"
DEFAULT_WIFI_PASS="Your_WiFi_Password"

# 2. EMQX Cloud Serverless (MQTT Broker)
MQTT_BROKER_HOST="xxxxxxxx.ala.asia-southeast1.emqxsl.com"
MQTT_BROKER_PORT=8883
MQTT_USERNAME="adht_device"
MQTT_PASSWORD="Your_Mqtt_Password"
DEVICE_ID="adht_weather_01"

# 3. Supabase Database (REST API)
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_TABLE="weather_logs"
